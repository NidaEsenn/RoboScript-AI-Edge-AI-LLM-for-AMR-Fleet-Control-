# Copy to .env and fill in. Never commit your real .env (it's gitignored).

# ---- data generation (roboscript/data/synthetic.py) -------------------------
PROVIDER=groq                 # gemini | groq | openai
GROQ_API_KEY=gsk_...          # https://console.groq.com/keys
GEMINI_API_KEY=               # https://aistudio.google.com/app/apikey
OPENAI_API_KEY=               # https://platform.openai.com/api-keys

# ---- training (gpu profile) ---------------------------------------------------
HF_TOKEN=hf_...               # Llama-3.1 weights/tokenizer + Hub pushes
HF_USERNAME=
BASE_MODEL=meta-llama/Llama-3.1-8B-Instruct
EDGE_MODEL=microsoft/Phi-3-mini-4k-instruct
WANDB_API_KEY=                # optional; enables report_to=wandb
WANDB_PROJECT=roboscript

# ---- serving -----------------------------------------------------------------
ROBOSCRIPT_BACKEND=rules      # rules | local | vllm
VLLM_URL=http://localhost:8080/v1
ROBOSCRIPT_SFT_PATH=outputs/roboscript-sft
ROBOSCRIPT_DPO_PATH=outputs/roboscript-dpo-merged
ROBOSCRIPT_DEADLINE_MS_EMERGENCY=300
ROBOSCRIPT_DEADLINE_MS_NAVIGATE=500
ROBOSCRIPT_INTERLOCK_FAST_PATH=1
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=roboscript

# ---- deployment --------------------------------------------------------------
AWS_DEFAULT_REGION=us-east-1
AWS_ACCOUNT_ID=
ECR_REPOSITORY=roboscript
SAGEMAKER_ROLE_ARN=
SAGEMAKER_INSTANCE_TYPE=ml.g4dn.xlarge
S3_ARTIFACT_BUCKET=roboscript-artifacts
SNS_TOPIC_ARN=
